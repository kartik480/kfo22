<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/light_pink"
        android:elevation="4dp"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <!-- ScrollView for content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- User Name Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="User Information"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_color"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/fullNameText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Full Name"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/usernameText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Username: N/A"
                        android:textSize="16sp"
                        android:textColor="@color/gray"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/employeeNoText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Employee ID: N/A"
                        android:textSize="16sp"
                        android:textColor="@color/gray"
                        android:layout_marginBottom="4dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Contact Information Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Contact Information"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_color"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/mobileText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mobile: N/A"
                        android:textSize="16sp"
                        android:textColor="@color/gray"
                        android:layout_marginBottom="8dp"
                        android:drawableStart="@drawable/ic_phone"
                        android:drawablePadding="8dp" />

                    <TextView
                        android:id="@+id/emailText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Email: N/A"
                        android:textSize="16sp"
                        android:textColor="@color/gray"
                        android:drawableStart="@drawable/ic_email"
                        android:drawablePadding="8dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Professional Information Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Professional Information"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_color"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/designationText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Designation: N/A"
                        android:textSize="16sp"
                        android:textColor="@color/gray"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/departmentText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Department: N/A"
                        android:textSize="16sp"
                        android:textColor="@color/gray"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Status: N/A"
                        android:textSize="16sp"
                        android:textColor="@color/gray"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/manageIconsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manage Icons: N/A"
                        android:textSize="16sp"
                        android:textColor="@color/gray" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Manager Information Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manager Information"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_color"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/managerNameText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manager: N/A"
                        android:textSize="16sp"
                        android:textColor="@color/gray"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/managerDesignationText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manager Designation: N/A"
                        android:textSize="16sp"
                        android:textColor="@color/gray" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
