<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Basic Information Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Basic Information"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/nameText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Full Name: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/usernameText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Username: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/emailText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Email: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/phoneText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Phone: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Status: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/employeeNoText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Employee No: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/designationText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Designation: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/departmentText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Department: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/birthDateText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Birth Date: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/rankText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Rank: N/A"
                        android:textSize="16sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Work Information Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Work Information"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/workStateText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Work State: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/workLocationText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Work Location: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/reportingToText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Reporting To: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/officialPhoneText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Official Phone: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/officialEmailText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Official Email: N/A"
                        android:textSize="16sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Address Information Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Address Information"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/residentialAddressText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Residential Address: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/officeAddressText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Office Address: N/A"
                        android:textSize="16sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Identity Information Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Identity Information"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/panNumberText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="PAN Number: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/aadhaarNumberText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Aadhaar Number: N/A"
                        android:textSize="16sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Bank Information Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bank Information"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/accHolderNameText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Account Holder Name: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/bankNameText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bank Name: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/accountTypeText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Account Type: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/branchNameText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Branch Name: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/accountNumberText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Account Number: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/ifscCodeText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="IFSC Code: N/A"
                        android:textSize="16sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Reference Information Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Reference Information"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/refName1Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Reference 1 Name: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/refRelation1Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Reference 1 Relation: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/refMobile1Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Reference 1 Mobile: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/refAddress1Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Reference 1 Address: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/refName2Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Reference 2 Name: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/refRelation2Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Reference 2 Relation: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/refMobile2Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Reference 2 Mobile: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/refAddress2Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Reference 2 Address: N/A"
                        android:textSize="16sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- System Information Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="System Information"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/manageIconsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manage Icons: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/dataIconsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Data Icons: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/createdByText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Created By: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/createdAtText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Created At: N/A"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/updatedAtText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Updated At: N/A"
                        android:textSize="16sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
